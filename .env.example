# Local development-only values. Replace only in an untracked .env file.
POSTGRES_USER=betterticket
POSTGRES_PASSWORD=betterticket_local
POSTGRES_DB=betterticket
DATABASE_URL=postgresql://betterticket:betterticket_local@localhost:5432/betterticket
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_BUCKET=betterticket-local
OBJECT_STORAGE_ACCESS_KEY=betterticket_local
OBJECT_STORAGE_SECRET_KEY=betterticket_local_secret
