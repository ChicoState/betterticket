{
  "name": "betterticket",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --parallel --filter @betterticket/api --filter @betterticket/web dev",
    "db:generate": "pnpm --filter @betterticket/api db:generate",
    "db:migrate": "pnpm --filter @betterticket/api db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --recursive --if-present typecheck",
    "test": "vitest run --passWithNoTests && pnpm --recursive --if-present test",
    "coverage": "vitest run --coverage --passWithNoTests && pnpm --recursive --if-present coverage",
    "test:smoke": "bash scripts/smoke.sh",
    "docker:up": "docker compose up --detach postgres object-storage",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.11.0",
    "jsdom": "^27.0.0",
    "pg": "^8.0.0",
    "prettier": "^3.9.8",
    "testcontainers": "^11.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
